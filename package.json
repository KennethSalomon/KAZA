{
  "name": "kaza-bj",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "lint": "npm run lint --workspace apps/web",
    "lint:fix": "npm run lint --workspace apps/web -- --fix",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css,json}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "supabase studio",
    "functions:serve": "supabase functions serve",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/database.types.ts",
    "db:types:check": "npm run db:types && git diff --exit-code apps/web/src/lib/database.types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": "^6.4.3",
    "postcss": "8.5.26",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
