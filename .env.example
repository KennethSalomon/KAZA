# ============================================================
# KAZA.BJ — Variables d'environnement (copier vers .env)
# Architecture « Supabase seule » : pas de backend applicatif.
# Ne JAMAIS committer de vraies clés.
# ============================================================

# ---- Supabase (PostgreSQL + PostGIS + Auth + Storage + Realtime + Edge Functions)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Clé "service_role" : réservée aux Edge Functions (Deno), jamais en frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Frontend
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_APP_NAME=Kaza
PUBLIC_APP_URL=http://localhost:3000
# Sitekey hCaptcha (PUBLIQUE par design). À définir dès que le captcha est
# activé côté Supabase (Settings → Auth → Bot and Abuse Protection) :
# l'API rejette sinon toute demande auth par 400 captcha_failed.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=YOUR_HCAPTCHA_SITEKEY

# ---- Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# ---- Paiement Mobile Money (FedaPay — sandbox par défaut)
# Secrets Edge Functions : définis dans supabase/config.toml (dev) ou le dashboard
# Supabase → Settings → Edge Functions → Secrets (production). Jamais en frontend.
FEDAPAY_SECRET_KEY=sk_dev_fedapay
FEDAPAY_WEBHOOK_SECRET=wh_dev_secret
FEDAPAY_API_BASE=https://sandbox-api.fedapay.com/v1
APP_URL=http://localhost:3000

# ---- Emails (Brevo). Sans clé : les emails de relance sont inactifs en local.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=kaza@kaza.bj
BREVO_SENDER_NAME=KAZA.BJ

# ---- CRON impayés : secret partagé entre pg_cron (net.http_post) et overdue-cron
CRON_SECRET=change-me

# ---- Quittances : signature visuelle + empreinte SHA-256 (MVP)
# Yousign prévu en V2 — aucune clé nécessaire au MVP.