# ============================================================
# KAZA.BJ — Variables d'environnement (copier vers .env)
# Architecture « Supabase seule » : pas de backend applicatif.
# Ne JAMAIS committer de vraies clés. Remplacez CHANGEME_* par vos secrets.
# ============================================================

# ---- Frontend (PUBLIQUES : embarquées dans le bundle navigateur par design)
# Ne jamais y mettre de secret (service_role, FedaPay, Brevo, CRON...).
NEXT_PUBLIC_SUPABASE_URL=CHANGEME_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGEME_anon_key
NEXT_PUBLIC_APP_URL=CHANGEME_app_url
# Sitekey hCaptcha (PUBLIQUE par design). Vide = captcha désactivé.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=CHANGEME_hcaptcha_sitekey

# ---- Monitoring (Sentry) — frontend + server
NEXT_PUBLIC_SENTRY_DSN=CHANGEME_NEXT_PUBLIC_SENTRY_DSN
# (build) Upload sourcemaps. Facultatifs (dryRun sinon).
SENTRY_ORG=CHANGEME_sentry_org
SENTRY_PROJECT=CHANGEME_sentry_project
SENTRY_AUTH_TOKEN=CHANGEME_sentry_auth_token

# ---- Supabase côté serveur / Edge Functions (Deno) — SECRETS
# Réservées aux Edge Functions via deno.env.get('SUPABASE_URL') /
# deno.env.get('SUPABASE_SERVICE_ROLE_KEY'). Jamais en frontend.
# SUPABASE_URL est injectée automatiquement par la plateforme Supabase.
SUPABASE_SERVICE_ROLE_KEY=CHANGEME_service_role_key
# Environnement pour Sentry Edge (dev / prod / preview)
SUPABASE_ENV=production
SENTRY_DSN=CHANGEME_sentry_dsn

# ---- Paiement Mobile Money (FedaPay — sandbox par défaut)
# Secrets Edge Functions : config.toml (dev) ou Dashboard Supabase → Edge Functions → Secrets (prod).
FEDAPAY_SECRET_KEY=sk_dev_fedapay
FEDAPAY_WEBHOOK_SECRET=wh_dev_secret
FEDAPAY_API_BASE=https://sandbox-api.fedapay.com/v1
# URL publique (Edge) : redirects webhook + confirmation FedaPay.
APP_URL=CHANGEME_app_url

# ---- Emails (Brevo). Sans clé : emails de relance inactifs.
BREVO_API_KEY=CHANGEME_brevo_api_key
BREVO_SENDER_EMAIL=CHANGEME_sender_email
BREVO_SENDER_NAME=KAZA.BJ

# ---- CRON impayés / visites : secret partagé pg_cron → Edge Function.
# Doit correspondre à la valeur insérée dans public._cron_secrets.
CRON_SECRET=CHANGEME_cron_secret